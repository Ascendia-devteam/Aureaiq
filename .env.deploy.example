# Copy to .env.deploy (gitignored) and fill in.
# Find these under hPanel -> Advanced -> SSH Access.
DEPLOY_HOST=
DEPLOY_PORT=22
DEPLOY_USER=
# Must end in a slash. This is the DOCUMENT ROOT — verify it before the
# first deploy; on Hostinger it is often a public_html inside the path
# hPanel shows you.
DEPLOY_PATH=
